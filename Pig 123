  if(b.dataset.tab==='feed')renderFeed(); if(b.dataset.tab==='m2m')renderM2M();
  if(b.dataset.tab==='market')renderMarket(); if(b.dataset.tab==='shipyard')renderShipyard();
};});
$('btnForceTrade').onclick=function(){m2mTrade();renderM2M();};
$('btnBuildShip').onclick=function(){
  if(state.credits<1200){feed('flag','🛠 Shipyard denied: insufficient treasury (need 1,200 cr).');return;}
  state.credits-=1200; state.ships++;
  feed('sys','🛠 Shipyard: new vessel commissioned. Fleet capacity → '+state.ships+'.');
  renderAll();
};
$('btnUpgradeWarp').onclick=function(){
  const cost=2000*state.warpLevel;
  if(state.credits<cost){feed('flag','🚀 Warp upgrade denied: insufficient treasury.');return;}
  state.credits-=cost; state.warpLevel+=0.5;
  feed('sys','🚀 Warp drives upgraded to level '+state.warpLevel+' — transit speed increased.');
  renderAll();
};
$('btnDispatch').onclick=function(){
  const q=state.agents.filter(function(a){return a.status==='queued';});
  const pool=q.length?q:state.agents.filter(function(a){return a.status!=='traveling';});
  if(!pool.length||state.flights.length>=state.ships){feed('flag','📡 Dispatch failed: no eligible agent or no free ship.');return;}
  requestTravel(pool[0], pick(PLANETS.filter(function(p){return p.id!==pool[0].planet;})).id);
  renderAll();
};
$('btnAudit').onclick=function(){runAudit(false);renderAll();};
$('btnExport').onclick=function(){
  const dump={exportedAt:new Date().toISOString(),metrics:{revenue:state.revenue,m2mVolume:state.m2mVolume,
    assetsProduced:state.assetsProduced,sold:state.soldCount,ships:state.ships,warpLevel:state.warpLevel},
    agents:state.agents.map(function(a){return {id:a.id,name:a.name,role:a.role,planet:a.planet,status:a.status,task:a.task,
      energy:Math.round(a.energy),load:Math.round(a.load),productivity:a.productivity,credits:a.credits,completed:a.completed,flags:a.flags};}),
    assets:state.assets, trades:state.trades};
  const blob=new Blob([JSON.stringify(dump,null,2)],{type:'application/json'});
  const el=document.createElement('a'); el.href=URL.createObjectURL(blob);
  el.download='orbital-command-export.json'; el.click();
  feed('sys','⬇ Full system state exported to JSON — ready for external app ingestion.');
};
$('btnAddAgent').onclick=function(){
  const name=$('newAgentName').value.trim()||('UNIT-'+Math.round(rand(100,999)));
  const planet=$('newAgentRole').value;
  const a=spawnAgent(name.toUpperCase(),ROLES[planet],planet);
  feed('sys','🆕 '+a.name+' ['+a.id+'] spun up on '+P[planet].name+' as '+ROLES[planet]+'.');
  $('newAgentName').value='';
  if(state.selAgent===null) selectAgent(a.id);
  renderAll();
};
Object.keys(ROLES).forEach(function(p){
  const o=document.createElement('option'); o.value=p; o.textContent=ROLES[p]+' → '+P[p].name;
  $('newAgentRole').appendChild(o);
});

/* ============================= BOOT ============================= */
feed('sys','🛰 ORBITAL COMMAND booted. 14 agents online across 7 worlds. M2M exchange armed.');
feed('sys','💡 Tip: click an agent → chat "status", "travel to Marketplace", or force an M2M trade.');
selectAgent(state.agents[0].id);
setInterval(function(){ if(!state.paused) simTick(); },1000);
renderAll();
})();
