/* ============================= CHAT / MESSAGING HUB ============================= */
function selectAgent(id){
  state.selAgent=id;
  const a=state.agents.find(function(x){return x.id===id;}); if(!a) return;
  $('chatHeader').innerHTML='<div class="cn">'+a.name+' <span style="color:var(--dim);font-size:10px">['+a.id+']</span></div>'+
    '<div class="cs">'+(ROLES[a.planet]||a.role)+' · 🪐 '+P[a.planet].name+' · ⚡'+Math.round(a.energy)+'% · 📈'+a.productivity+'%</div>';
  $('chatText').disabled=false; $('btnSend').disabled=false;
  if(!state.chats[a.id].length){
    state.chats[a.id].push({who:'agent',whoName:a.name,text:FLAVOR[a.planet][1]+'. '+a.name+' reporting — currently "'+a.task+'" on '+P[a.planet].name+'. Awaiting orders, Commander.'});
  }
  renderChat(); renderRoster();
}
function renderChat(){
  const log=$('chatLog'), msgs=state.selAgent?state.chats[state.selAgent]:[];
  log.innerHTML=msgs.map(function(m){
    return '<div class="msg '+m.who+'">'+(m.who==='agent'?'<div class="who">'+m.whoName+'</div>':'')+m.text+'</div>';}).join('')
    ||'<div class="empty">// LINK INACTIVE //</div>';
  log.scrollTop=log.scrollHeight;
}
function agentReply(a,userText){
  const t=userText.toLowerCase();
  const lines=[];
  const statusLine=function(){return '📋 STATUS · planet '+P[a.planet].name+' · task "'+a.task+'" ('+Math.round(a.progress)+'/'+a.needTicks+') · ⚡'+Math.round(a.energy)+'% · 🖥 load '+Math.round(a.load)+'% · 📈 productivity '+a.productivity+'% · 🏅 '+a.completed+' deliverables · 💳 '+fmt(a.credits);};
  const planetHit=PLANETS.find(function(p){return t.indexOf(p.name.toLowerCase().split(' ')[0])>-1||t.indexOf(p.id)>-1;});
  if(t.indexOf('status')>-1||t.indexOf('report')>-1){ lines.push(statusLine()); }
  else if(planetHit){ requestTravel(a,planetHit.id); lines.push('🛸 Copy. Requesting ship assignment to '+planetHit.name+'. '+(state.flights.length>=state.ships?'Fleet is saturated — I may queue.':'Vector plotted, launching now.')); }
  else if(t.indexOf('audit')>-1){ const others=state.agents.filter(function(x){return x!==a;}); if(others.length){ runAudit(true); lines.push('🔍 Running spot-audit on '+pick(others).name+'… result posted to the Activity Feed.'); } }
  else if(t.indexOf('trade')>-1){ m2mTrade(); lines.push('🔁 Opening the exchange books — trade executed, see M2M tab.'); }
  else if(t.indexOf('work')>-1||t.indexOf('task')>-1){ if(a.status!=='working')assignTask(a); lines.push('⚙ On it. Task: "'+a.task+'" on '+P[a.planet].name+'.'); }
  else if(t.indexOf('hello')>-1||t.indexOf('hi')>-1||t.indexOf('hey')>-1){ lines.push(pick(FLAVOR[a.planet])+' — '+a.name+' on deck. Say "status", "travel to …", "audit", or "trade".'); }
  else { lines.push(pick(FLAVOR[a.planet])+'. '+statusLine()); }
  return lines;
}
function sendChat(){
  const text=$('chatText').value.trim(); if(!text||!state.selAgent) return;
  const a=state.agents.find(function(x){return x.id===state.selAgent;});
  state.chats[a.id].push({who:'user',text:text}); $('chatText').value='';
  renderChat();
  setTimeout(function(){
    agentReply(a,text).forEach(function(l,i){setTimeout(function(){
      state.chats[a.id].push({who:'agent',whoName:a.name,text:l}); renderChat();
    },350+i*450);});
  },400);
}

