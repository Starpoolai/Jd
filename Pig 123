<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>ORBITAL COMMAND — Planetary AI Enterprise</title>
<style>
  :root{
    --bg:#05070f; --panel:#0b1120; --panel2:#0e1628; --line:#1b2a4a;
    --cyan:#00e5ff; --violet:#b44fff; --pink:#ff4fd8; --green:#22e58c;
    --amber:#ffb020; --red:#ff5566; --text:#cfe3ff; --dim:#6b84b0;
    --mono:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{
    background:radial-gradient(1200px 700px at 70% -10%,#0c1a3a 0%,var(--bg) 60%);
    color:var(--text); font-family:'Inter',system-ui,sans-serif; height:100vh; overflow:hidden;
  }
  body::after{content:'';position:fixed;inset:0;pointer-events:none;
    background:repeating-linear-gradient(0deg,transparent 0 3px,rgba(0,229,255,.02) 3px 4px);}
  #app{display:grid;grid-template-rows:56px 1fr;grid-template-columns:290px 1fr 340px;
    grid-template-areas:"top top top" "left main right";height:100vh;gap:10px;padding:10px}
  header{grid-area:top;display:flex;align-items:center;gap:14px;padding:0 16px;
    background:linear-gradient(90deg,rgba(11,17,32,.9),rgba(14,22,40,.9));
    border:1px solid var(--line);border-radius:12px}
  .logo{font-family:var(--mono);font-weight:700;letter-spacing:3px;color:var(--cyan);
    text-shadow:0 0 18px rgba(0,229,255,.6);font-size:15px}
  .logo span{color:var(--violet)}
  .kpis{display:flex;gap:8px;flex:1;flex-wrap:wrap;justify-content:center}
  .kpi{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:5px 12px;min-width:104px}
  .kpi b{display:block;font-family:var(--mono);font-size:14px;color:#fff}
  .kpi small{font-size:9px;letter-spacing:1.5px;color:var(--dim);text-transform:uppercase}
  .simctl{display:flex;gap:6px}
  button{background:var(--panel2);border:1px solid var(--line);color:var(--text);
    font-family:var(--mono);font-size:11px;padding:7px 12px;border-radius:8px;cursor:pointer;
    transition:all .18s ease;letter-spacing:.5px}
  button:hover{border-color:var(--cyan);color:var(--cyan);box-shadow:0 0 12px rgba(0,229,255,.25);transform:translateY(-1px)}
  button:active{transform:translateY(0)}
  button.primary{background:linear-gradient(135deg,rgba(0,229,255,.15),rgba(180,79,255,.15));border-color:var(--cyan)}
  button.danger{border-color:var(--red);color:var(--red)}
  button:disabled{opacity:.4;cursor:not-allowed;transform:none}
  aside,#mainCol{background:rgba(11,17,32,.85);border:1px solid var(--line);border-radius:12px;
    display:flex;flex-direction:column;overflow:hidden;min-height:0}
  #left{grid-area:left}#mainCol{grid-area:main}#right{grid-area:right}
  .pane-title{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;
    border-bottom:1px solid var(--line);font-family:var(--mono);font-size:11px;
    letter-spacing:2px;color:var(--cyan);text-transform:uppercase;background:rgba(0,229,255,.04)}
  .pane-title .badge{background:var(--panel2);border:1px solid var(--line);border-radius:20px;
    padding:2px 9px;color:var(--dim);font-size:10px}
  .scroll{overflow-y:auto;flex:1;min-height:0}
  .scroll::-webkit-scrollbar{width:6px}.scroll::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}

  .agent-card{padding:9px 12px;border-bottom:1px solid rgba(27,42,74,.5);cursor:pointer;transition:background .15s}
  .agent-card:hover{background:rgba(0,229,255,.05)}
  .agent-card.sel{background:rgba(180,79,255,.1);border-left:2px solid var(--violet)}
  .agent-card .row1{display:flex;justify-content:space-between;align-items:center}
  .agent-card .name{font-size:12px;font-weight:600}
  .agent-card .st{font-family:var(--mono);font-size:9px;padding:2px 7px;border-radius:10px}
  .st.working{color:var(--green);border:1px solid rgba(34,229,140,.4)}
  .st.traveling{color:var(--cyan);border:1px solid rgba(0,229,255,.4)}
  .st.idle{color:var(--dim);border:1px solid var(--line)}
  .st.flagged{color:var(--red);border:1px solid rgba(255,85,102,.5);animation:blink 1s infinite}
  .st.queued{color:var(--amber);border:1px solid rgba(255,176,32,.4)}
  @keyframes blink{50%{opacity:.4}}
  .agent-card .meta{font-size:10px;color:var(--dim);margin-top:3px}
  .bar{height:4px;background:#101a30;border-radius:2px;margin-top:5px;overflow:hidden;display:flex;gap:3px}
  .bar i{display:block;height:100%;border-radius:2px}
  .addform{padding:10px 12px;border-top:1px solid var(--line);display:flex;gap:6px}
  .addform input{flex:1;background:#0a1322;border:1px solid var(--line);border-radius:7px;
    color:var(--text);padding:7px 9px;font-size:11px;min-width:0}
  .addform input:focus{outline:none;border-color:var(--cyan)}
  .addform select{background:#0a1322;border:1px solid var(--line);border-radius:7px;color:var(--text);font-size:11px}

  #mapWrap{position:relative;flex:1;min-height:0}
  #starmap{width:100%;height:100%;display:block;cursor:crosshair}
  #planetTip{position:absolute;pointer-events:none;background:rgba(5,10,20,.95);border:1px solid var(--cyan);
    border-radius:8px;padding:8px 11px;font-family:var(--mono);font-size:10px;line-height:1.7;
    display:none;z-index:5;box-shadow:0 0 20px rgba(0,229,255,.2);white-space:nowrap}
  #mapHint{position:absolute;left:12px;bottom:10px;font-family:var(--mono);font-size:9px;
    color:var(--dim);letter-spacing:1px;pointer-events:none}

  #tabs{display:flex;gap:2px;padding:0 8px;border-bottom:1px solid var(--line);background:rgba(0,229,255,.03)}
  #tabs button{border:none;border-radius:0;background:transparent;color:var(--dim);padding:9px 13px;font-size:10px}
  #tabs button.on{color:var(--cyan);box-shadow:inset 0 -2px 0 var(--cyan)}
  .tabpane{display:none;padding:10px 12px;height:230px;overflow-y:auto}
  .tabpane.on{display:block}
  .ev{font-family:var(--mono);font-size:10.5px;padding:4px 8px;border-left:2px solid var(--line);
    margin-bottom:4px;background:rgba(14,22,40,.5);border-radius:0 6px 6px 0;animation:slidein .25s ease}
  @keyframes slidein{from{opacity:0;transform:translateX(-8px)}}
  .ev.t-flag{border-color:var(--red);color:#ffb3bc}
  .ev.t-trade{border-color:var(--amber);color:#ffe2b0}
  .ev.t-sale{border-color:var(--green);color:#b8f5d9}
  .ev.t-asset{border-color:var(--violet);color:#dcc2ff}
  .ev.t-sys{border-color:var(--cyan);color:#bfeeff}
  .ev .ts{color:var(--dim);margin-right:8px}
  table{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:10.5px}
  th{color:var(--dim);text-align:left;padding:5px 8px;border-bottom:1px solid var(--line);font-size:9px;letter-spacing:1px}
  td{padding:5px 8px;border-bottom:1px solid rgba(27,42,74,.4)}
  .sect{font-family:var(--mono);font-size:10px;color:var(--cyan);letter-spacing:1.5px;margin:10px 0 6px}
  .code{background:#08101f;border:1px solid var(--line);border-radius:8px;padding:9px 11px;
    font-family:var(--mono);font-size:10px;color:#9fd8ff;white-space:pre-wrap;line-height:1.6}
  .shiprow{display:flex;gap:8px;align-items:center;margin-bottom:8px;flex-wrap:wrap}

  #chatLog{padding:10px;display:flex;flex-direction:column;gap:8px}
  .msg{max-width:85%;padding:8px 11px;border-radius:10px;font-size:11.5px;line-height:1.5;animation:slidein .25s ease}
  .msg.agent{background:var(--panel2);border:1px solid var(--line);align-self:flex-start;border-bottom-left-radius:2px}
  .msg.user{background:linear-gradient(135deg,rgba(0,229,255,.18),rgba(180,79,255,.18));
    border:1px solid rgba(0,229,255,.35);align-self:flex-end;border-bottom-right-radius:2px}
  .msg .who{font-family:var(--mono);font-size:9px;color:var(--cyan);margin-bottom:3px;letter-spacing:1px}
  .msg.user .who{color:var(--violet)}
  #chatHeader{padding:9px 14px;border-bottom:1px solid var(--line)}
  #chatHeader .cn{font-size:12px;font-weight:600}
  #chatHeader .cs{font-family:var(--mono);font-size:9.5px;color:var(--dim);margin-top:2px}
  #chatInput{display:flex;gap:6px;padding:10px;border-top:1px solid var(--line)}
  #chatInput input{flex:1;background:#0a1322;border:1px solid var(--line);border-radius:8px;
    color:var(--text);padding:9px 11px;font-size:12px}
  #chatInput input:focus{outline:none;border-color:var(--cyan)}
  .charts{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:8px 12px 10px}
  .chartcard{background:var(--panel);border:1px solid var(--line);border-radius:9px;padding:7px 9px}
  .chartcard small{font-size:8.5px;letter-spacing:1.2px;color:var(--dim);text-transform:uppercase}
  .chartcard b{display:block;font-family:var(--mono);font-size:12px;color:#fff;margin:2px 0 4px}
  .chartcard canvas{width:100%;height:34px;display:block}
  .empty{color:var(--dim);font-size:11px;text-align:center;padding:24px 10px;font-family:var(--mono)}
</style>
</head>
<body>
<div id="app">
  <header>
    <div class="logo">ORBITAL<span>::</span>COMMAND</div>
    <div class="kpis" id="kpis"></div>
    <div class="simctl">
      <button id="btnPause">⏸ PAUSE</button>
      <button id="btnSpeed">SPEED ×1</button>
    </div>
  </header>

  <aside id="left">
    <div class="pane-title">AGENT ROSTER <span class="badge" id="agentCount">0</span></div>
    <div class="scroll" id="roster"></div>
    <div class="addform">
      <input id="newAgentName" placeholder="Agent name…" maxlength="24"/>
      <select id="newAgentRole"></select>
      <button id="btnAddAgent" class="primary">+ ADD</button>
    </div>
  </aside>

  <div id="mainCol">
    <div class="pane-title">PLANETARY SYSTEM — LIVE STAR MAP <span class="badge" id="shipBadge">SHIPS 2/2</span></div>
    <div id="mapWrap">
      <canvas id="starmap" width="980" height="520"></canvas>
      <div id="planetTip"></div>
      <div id="mapHint">CLICK A PLANET TO INSPECT · AGENTS TRANSIT VIA SHIPYARD FLEET</div>
    </div>
    <div class="charts">
      <div class="chartcard"><small>System Revenue</small><b id="cvRevenue">$0</b><canvas id="chRevenue" width="200" height="34"></canvas></div>
      <div class="chartcard"><small>M2M Volume</small><b id="cvM2M">$0</b><canvas id="chM2M" width="200" height="34"></canvas></div>
      <div class="chartcard"><small>Asset Yield</small><b id="cvAssets">0</b><canvas id="chAssets" width="200" height="34"></canvas></div>
      <div class="chartcard"><small>Avg Efficiency</small><b id="cvEff">0%</b><canvas id="chEff" width="200" height="34"></canvas></div>
    </div>
    <div id="tabs">
      <button data-tab="feed" class="on">ACTIVITY / SNITCH FEED</button>
      <button data-tab="m2m">M2M EXCHANGE</button>
      <button data-tab="market">MARKETPLACE</button>
      <button data-tab="shipyard">SHIPYARD</button>
      <button data-tab="integrations">INTEGRATIONS</button>
    </div>
    <div class="tabpane on" id="tab-feed"><div class="scroll" id="feedList"></div></div>
    <div class="tabpane" id="tab-m2m">
      <div class="shiprow"><button class="primary" id="btnForceTrade">⚡ FORCE M2M TRADE</button>
      <span style="font-family:var(--mono);font-size:10px;color:var(--dim)" id="m2mSummary"></span></div>
      <table><thead><tr><th>TIME</th><th>SELLER</th><th>BUYER</th><th>ASSET</th><th>PRICE</th></tr></thead><tbody id="m2mTable"></tbody></table>
    </div>
    <div class="tabpane" id="tab-market">
      <div class="sect">LISTED INTELLECTUAL PROPERTY — CONSUMER MARKETPLACE PLANET</div>
      <table><thead><tr><th>ASSET</th><th>CREATOR</th><th>TYPE</th><th>PRICE</th><th>STATUS</th></tr></thead><tbody id="marketTable"></tbody></table>
    </div>
    <div class="tabpane" id="tab-shipyard">
      <div class="sect">FLEET COMMAND — CONSTRUCT &amp; UPGRADE</div>
      <div class="shiprow">
        <button class="primary" id="btnBuildShip">🛠 BUILD SHIP — 1,200 cr</button>
        <button id="btnUpgradeWarp">🚀 UPGRADE WARP LV — 2,000 cr</button>
        <button id="btnDispatch">📡 DISPATCH IDLE AGENT</button>
        <button class="danger" id="btnAudit">🔍 RUN AUDIT NOW</button>
      </div>
      <div class="sect">FLEET STATUS</div>
      <div class="code" id="fleetStatus"></div>
    </div>
    <div class="tabpane" id="tab-integrations">
      <div class="sect">EXTERNAL MONETIZATION HOOKS — EXPORT PIPELINE</div>
      <div class="shiprow"><button class="primary" id="btnExport">⬇ EXPORT FULL SYSTEM STATE (JSON)</button></div>
      <div class="code" id="apiSchema"></div>
    </div>
  </div>

  <aside id="right">
    <div class="pane-title">TWO-WAY MESSAGING HUB</div>
    <div id="chatHeader"><div class="cn">Select an agent…</div><div class="cs">click an agent in the roster</div></div>
    <div class="scroll" id="chatLog"><div class="empty">// LINK INACTIVE //</div></div>
    <div id="chatInput">
      <input id="chatText" placeholder="Message agent… (try: status / travel to / audit / trade)" disabled/>
      <button id="btnSend" class="primary" disabled>SEND</button>
    </div>
  </aside>
</div>

<script>
(function(){
'use strict';

/* ============================= WORLD DATA ============================= */
const PLANETS = [
  {id:'command',   name:'Command & Shipyard',      color:'#00e5ff', orbit:0,   speed:0,    angle:0,
   desc:'Administrative hub · fleet construction · recharging'},
  {id:'social',    name:'Social Media Planet',     color:'#ff4fd8', orbit:95,  speed:.00045,angle:0.4,
   desc:'Campaigns · content calendars · multi-platform direction'},
  {id:'ebook',     name:'E-Book Planet',           color:'#4f8dff', orbit:150, speed:.00034,angle:2.1,
   desc:'Outlining · drafting · multi-genre e-book formatting'},
  {id:'rnd',       name:'R&D & Thumbnail Planet',  color:'#ffb020', orbit:205, speed:.00027,angle:4.0,
   desc:'Market research · trend analysis · thumbnail concept prompts'},
  {id:'influencer',name:'AI Influencer Planet',    color:'#b44fff', orbit:258, speed:.00021,angle:5.3,
   desc:'Persona design · scripting · virtual influencer management'},
  {id:'market',    name:'Consumer Marketplace',    color:'#22e58c', orbit:312, speed:.00016,angle:1.2,
   desc:'External buyer sales · IP monetization · revenue'},
  {id:'m2m',       name:'M2M Trading Exchange',    color:'#ff5533', orbit:364, speed:.00012,angle:3.4,
   desc:'Agent-to-agent trading · data & micro-service exchange'},
];
const P = Object.fromEntries(PLANETS.map(p=>[p.id,p]));

const ROLES = {
  command:   'Fleet Commander',   social: 'Campaign Strategist',
  ebook:     'Digital Author',    rnd:    'Trend Analyst',
  influencer:'Persona Architect', market: 'Merchant Broker', m2m:'Quant Trader'
};
const TASKS = {
  social:[['Draft multi-platform campaign',5],['Build 14-day content calendar',6],['Write viral thread series',4],['A/B test post hooks',5]],
  ebook:[['Outline new e-book',4],['Draft chapter block',7],['Edit & format manuscript',5],['Brief cover design',3]],
  rnd:[['Run trend scan sweep',4],['Competitor CTR audit',5],['Generate thumbnail concept batch',5],['Package thumbnail prompt pack',4]],
  influencer:[['Train persona voice model',6],['Script influencer reel',4],['Design persona lookbook',5],['Simulate engagement cycle',4]],
  command:[['Allocate fleet resources',3],['Maintenance sweep',3],['Upgrade command protocols',4]],
  market:[['List finished IP product',3],['Negotiate buyer deal',5],['Fulfill pending orders',4]],
  m2m:[['Package raw data bundle',3],['Quote micro-service API',4],['Run arbitrage scan',3]],
};
const ASSET_OF = {social:'Social Campaign Pack', ebook:'E-Book Draft', rnd:'Thumbnail Pack',
  influencer:'Persona Kit', command:'Ops Report', market:'Sales Contract', m2m:'Data Bundle'};
const FLAVOR = {
  social:['⚡','Broadcasting on all channels','The algorithm loves us today'],
  ebook:['📖','Ink flowing','Chapter count rising'],
  rnd:['📊','Signal in the noise','Thumbnails convert or die'],
  influencer:['🎭','Persona resonating','The virtuals must feel real'],
  command:['🛰','Holding the line','Fleet discipline maintained'],
  market:['💰','Closing loops','Revenue is oxygen'],
  m2m:['🔁','Arbitrage never sleeps','Liquidity is logic'],
};

/* ============================= STATE ============================= */
let uid=0; const nid=()=> 'A-'+String(++uid).padStart(3,'0');
const rand=(a,b)=>a+Math.random()*(b-a);
const pick=a=>a[Math.floor(Math.random()*a.length)];
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const fmt=n=>'$'+Math.round(n).toLocaleString();

const state = {
  tick:0, paused:false, speed:1,
  credits:5000, revenue:0, m2mVolume:0, assetsProduced:0, soldCount:0,
  ships:2, warpLevel:1,
  agents:[], flights:[], assets:[], feed:[], trades:[],
  history:{revenue:[],m2m:[],assets:[],eff:[]},
  selAgent:null, selPlanet:null, chats:{},
};

function spawnAgent(name, role, planetId, seedProd){
  const a = {
    id:nid(), name, role,
    planet:planetId, status:'working',
    task:null, progress:0, needTicks:0,
    energy:rand(70,100), load:rand(20,60), productivity:seedProd||Math.round(rand(55,95)),
    credits:Math.round(rand(150,900)), completed:0, flags:0, lastResult:'—',
  };
  assignTask(a);
  state.agents.push(a);
  if(!state.chats[a.id]) state.chats[a.id]=[];
  return a;
}
function assignTask(a){
  const list=TASKS[a.planet]||TASKS.command;
  const t=list[Math.floor(Math.random()*list.length)];
  a.task=t[0]; a.needTicks=Math.round(t[1]*rand(.8,1.3)); a.progress=0;
  a.status='working';
  feed('sys',a.name+' started task on '+P[a.planet].name+': "'+a.task+'"');
}
function feed(type,text){
  state.feed.unshift({t:clock(),type,text});
  if(state.feed.length>250) state.feed.pop();
  if(document.getElementById('tab-feed').classList.contains('on')) renderFeed();
}
function clock(){const s=Math.floor(state.tick*6);return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');}

/* ============================= INIT ROSTER ============================= */
const START=[
  ['NOVA-7','m2m'],['QUILL','ebook'],['VANTA','social'],['ORACLE-X','rnd'],['MUSE-9','influencer'],
  ['ATLAS','command'],['LEDGER','market'],['CIPHER','m2m'],['SORCERESS','social'],['INKWELL','ebook'],
  ['HAWK-EYE','rnd'],['SIREN','influencer'],['FORGE','command'],['BARTER-Prime','market'],
];
START.forEach(function(pair,i){spawnAgent(pair[0],ROLES[pair[1]],pair[1], 60+((i*13)%35));});

/* ============================= SIMULATION TICK ============================= */
function simTick(){
  state.tick++;
  for(const a of state.agents){
    if(a.status==='traveling'||a.status==='queued') continue;
    if(a.status==='resting'){
      a.energy=clamp(a.energy+6,0,100); a.load=clamp(a.load-10,5,100);
      if(a.energy>60){a.status='working';assignTask(a);}
      continue;
    }
    a.energy=clamp(a.energy-2.2,0,100);
    a.load=clamp(a.load+rand(-6,7),5,100);
    const eff=(a.productivity/100)*(0.5+a.energy/200);
    a.progress+=eff;
    if(a.progress>=a.needTicks){ completeTask(a); }
    if(a.energy<18 && a.status==='working'){
      a.status='resting'; a.task='Recharging at station';
      feed('flag','🔋 '+a.name+' dropped to LOW POWER — resting until recharge.');
    }
  }
  for(const f of [...state.flights]){
    f.progress+=f.speed*state.speed;
    if(f.progress>=1){
      const a=f.agent; a.planet=f.to; a.status='working'; a.energy=clamp(a.energy-8,0,100);
      assignTask(a);
      state.flights.splice(state.flights.indexOf(f),1);
      feed('sys','🛸 '+a.name+' docked at '+P[f.to].name+'.');
      const queued=state.agents.find(function(x){return x.status==='queued';});
      if(queued) requestTravel(queued, pick(PLANETS.filter(function(p){return p.id!==queued.planet;})).id);
    }
  }
  if(Math.random()<0.18) m2mTrade();
  for(const as of state.assets){
    if(as.status==='listed' && Math.random()<0.05+as.price/20000){
      as.status='sold'; state.revenue+=as.price; state.credits+=as.price; state.soldCount++;
      feed('sale','💵 SOLD "'+as.name+'" by '+as.creator+' → external buyer · '+fmt(as.price));
    }
  }
  if(Math.random()<0.14) runAudit(true);
  for(const a of state.agents){
    if(a.status==='working' && a.progress>a.needTicks*0.4 && Math.random()<0.03) requestTravel(a, pick(PLANETS).id);
  }
  pushHistory();
  renderAll();
}

function completeTask(a){
  a.completed++; a.productivity=clamp(a.productivity+1,20,100);
  const value=Math.round(rand(80,520));
  const asset={id:'IP-'+Math.round(rand(1000,9999)), name:ASSET_OF[a.planet]+' #'+(state.assetsProduced+1),
    creator:a.name, type:ASSET_OF[a.planet], planet:a.planet, price:value, status:'listed', tick:state.tick};
  state.assets.push(asset); state.assetsProduced++;
  a.credits+=Math.round(value*0.25); state.credits+=Math.round(value*0.1);
  a.lastResult='Delivered '+asset.name+' (val '+fmt(value)+')';
  feed('asset','📦 '+a.name+' completed "'+a.task+'" → '+asset.name+' listed on Marketplace ('+fmt(value)+')');
  assignTask(a);
}

function m2mTrade(){
  const active=state.agents.filter(function(a){return a.status!=='traveling';});
  if(active.length<2) return;
  const seller=pick(active); let buyer=pick(active);
  if(seller===buyer) buyer=pick(active.filter(function(x){return x!==seller;}));
  if(!buyer) return;
  const inter=pick(['Raw Trend Data','Outline Skeleton','Persona Voice Model','CTR Heuristics','Prompt Pack','Audience Graph','Micro-service: Render']);
  const price=Math.round(rand(30,240));
  if(buyer.credits<price){ feed('trade','❌ '+buyer.name+' lacked credits for '+inter+' from '+seller.name+'.'); return; }
  buyer.credits-=price; seller.credits+=price; seller.productivity=clamp(seller.productivity+1,20,100);
  state.m2mVolume+=price;
  state.trades.unshift({t:clock(),seller:seller.name,buyer:buyer.name,asset:inter,price:price});
  if(state.trades.length>60) state.trades.pop();
  feed('trade','🔁 M2M: '+seller.name+' → '+buyer.name+' · '+inter+' · '+fmt(price));
}

function runAudit(auto){
  if(state.agents.length<2) return;
  const auditor=pick(state.agents);
  const others=state.agents.filter(function(a){return a!==auditor;});
  const target=pick(others);
  const weak = target.energy<30 || target.productivity<50 || target.status==='queued';
  if(weak){
    target.flags++;
    feed('flag','🚨 SNITCH: '+auditor.name+' flagged '+target.name+' — '+(target.status==='queued'?'stalled awaiting ship':(target.energy<30?'low power':'productivity '+target.productivity+'%'))+'. Logged to accountability ledger.');
  }else{
    feed('sys','✅ AUDIT: '+auditor.name+' cleared '+target.name+' — output nominal ('+target.completed+' deliverables).');
  }
}

function requestTravel(a,toId){
  if(toId===a.planet||a.status==='traveling') return;
  if(state.flights.length>=state.ships){
    a.status='queued'; a.task='Awaiting ship assignment';
    feed('flag','⏳ '+a.name+' QUEUED — no ship available ('+state.flights.length+'/'+state.ships+' deployed). Build more at Shipyard.');
    return;
  }
  a.status='traveling'; a.task='In transit → '+P[toId].name;
  const speed=(0.006+Math.random()*0.004)*state.warpLevel;
  state.flights.push({agent:a,from:a.planet,to:toId,progress:0,speed:speed});
  feed('sys','🚀 '+a.name+' launched from '+P[a.planet].name+' → '+P[toId].name+' (warp lv '+state.warpLevel+').');
}

function pushHistory(){
  const h=state.history, cap=60;
  const avgEff=state.agents.length?state.agents.reduce(function(s,a){return s+a.productivity;},0)/state.agents.length:0;
  h.revenue.push(state.revenue); h.m2m.push(state.m2mVolume);
  h.assets.push(state.assetsProduced); h.eff.push(avgEff);
  for(const k in h) if(h[k].length>cap) h[k].shift();
}

/* ============================= CANVAS STAR MAP ============================= */
const cv=document.getElementById('starmap'), ctx=cv.getContext('2d');
const tip=document.getElementById('planetTip');
let lastFrame=performance.now();
PLANETS.forEach(function(p){ if(p.orbit) p.angle+=rand(0,6.28); });

function planetPos(p){ const cx=cv.width/2, cy=cv.height/2;
  if(!p.orbit) return {x:cx,y:cy};
  return {x:cx+Math.cos(p.angle)*p.orbit, y:cy+Math.sin(p.angle)*p.orbit*0.62}; }

function drawMap(dt){
  ctx.clearRect(0,0,cv.width,cv.height);
  for(let i=0;i<70;i++){const x=(i*137.5)%cv.width,y=(i*89.7)%cv.height;
    ctx.fillStyle='rgba(160,200,255,'+(0.15+0.25*Math.abs(Math.sin(state.tick*0.02+i)))+')';
    ctx.fillRect(x,y,1.4,1.4);}
  for(const p of PLANETS){ if(!p.orbit) continue;
    ctx.beginPath(); ctx.ellipse(cv.width/2,cv.height/2,p.orbit,p.orbit*0.62,0,0,7);
    ctx.strokeStyle=state.selPlanet===p.id?p.color:'rgba(60,90,150,.28)'; ctx.lineWidth=1; ctx.stroke(); }
  for(const p of PLANETS){
    const pos=planetPos(p), x=pos.x, y=pos.y;
    const g=ctx.createRadialGradient(x,y,2,x,y,p.orbit?16:34);
    g.addColorStop(0,p.color); g.addColorStop(.35,p.color+'aa'); g.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=g; ctx.beginPath();
    ctx.arc(x,y,p.orbit?16:34,0,7); ctx.fill();
    ctx.fillStyle=p.color; ctx.beginPath(); ctx.arc(x,y,p.orbit?7:14,0,7); ctx.fill();
    ctx.fillStyle='#dff4ff'; ctx.font='9px monospace'; ctx.textAlign='center';
    ctx.fillText(p.name.toUpperCase(),x,y+(p.orbit?30:44));
    const here=state.agents.filter(function(a){return a.planet===p.id;}).length;
    if(here){ ctx.fillStyle='#fff'; ctx.font='bold 9px monospace';
      ctx.fillText('['+here+']',x,y-16); }
  }
  for(const f of state.flights){
    const a=planetPos(P[f.from]), b=planetPos(P[f.to]);
    const x=a.x+(b.x-a.x)*f.progress, y=a.y+(b.y-a.y)*f.progress;
    ctx.save(); ctx.translate(x,y); ctx.rotate(Math.atan2(b.y-a.y,b.x-a.x));
    ctx.fillStyle='#00e5ff'; ctx.shadowColor='#00e5ff'; ctx.shadowBlur=10;
    ctx.beginPath(); ctx.moveTo(7,0); ctx.lineTo(-5,4); ctx.lineTo(-5,-4); ctx.closePath(); ctx.fill();
    ctx.restore();
    ctx.strokeStyle='rgba(0,229,255,.35)'; ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
  }
}
function frame(now){
  const dt=Math.min((now-lastFrame)/16.6,3); lastFrame=now;
  if(!state.paused){
    for(const p of PLANETS) p.angle+=p.speed*dt*state.speed;
    drawMap(dt);
  }
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);

cv.addEventListener('mousemove',function(e){
  const r=cv.getBoundingClientRect(), mx=(e.clientX-r.left)*(cv.width/r.width), my=(e.clientY-r.top)*(cv.height/r.height);
  let hit=null;
  for(const p of PLANETS){const pos=planetPos(p); if(Math.hypot(mx-pos.x,my-pos.y)<(p.orbit?22:36)) hit=p;}
  if(hit){ tip.style.display='block'; tip.style.left=(e.clientX-r.left+14)+'px'; tip.style.top=(e.clientY-r.top+10)+'px';
    const crew=state.agents.filter(function(a){return a.planet===hit.id;});
    tip.innerHTML='<b style="color:'+hit.color+'">'+hit.name+'</b><br>'+hit.desc+'<br>AGENTS: '+(crew.length?crew.map(function(a){return a.name;}).join(', '):'none');
  } else tip.style.display='none';
});
cv.addEventListener('click',function(e){
  const r=cv.getBoundingClientRect(), mx=(e.clientX-r.left)*(cv.width/r.width), my=(e.clientY-r.top)*(cv.height/r.height);
  for(const p of PLANETS){const pos=planetPos(p);
    if(Math.hypot(mx-pos.x,my-pos.y)<(p.orbit?22:36)){
      state.selPlanet=p.id;
      const crew=state.agents.filter(function(a){return a.planet===p.id;});
      feed('sys','🔎 Inspected '+p.name+' — '+crew.length+' agents on station.');
      return;}}
});

