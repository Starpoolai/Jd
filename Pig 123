function drawChart(id,data,color){
  const c=$(id),g=c.getContext('2d'); g.clearRect(0,0,c.width,c.height);
  if(data.length<2) return;
  const min=Math.min.apply(null,data), max=Math.max.apply(null,data)||1, span=(max-min)||1;
  g.beginPath();
  data.forEach(function(v,i){const x=i/(data.length-1)*c.width, y=c.height-3-((v-min)/span)*(c.height-8);
    if(i)g.lineTo(x,y);else g.moveTo(x,y);});
  g.strokeStyle=color; g.lineWidth=1.5; g.shadowColor=color; g.shadowBlur=6; g.stroke();
}
function renderCharts(){
  drawChart('chRevenue',state.history.revenue,'#22e58c');
  drawChart('chM2M',state.history.m2m,'#ffb020');
  drawChart('chAssets',state.history.assets,'#b44fff');
  drawChart('chEff',state.history.eff,'#00e5ff');
  $('cvRevenue').textContent=fmt(state.revenue);
  $('cvM2M').textContent=fmt(state.m2mVolume);
  $('cvAssets').textContent=state.assetsProduced;
  const avgEff=state.agents.length?Math.round(state.agents.reduce(function(s,a){return s+a.productivity;},0)/state.agents.length):0;
  $('cvEff').textContent=avgEff+'%';
}

function renderAll(){ renderKPIs(); renderRoster(); renderCharts(); renderShipyard();
  if($('tab-feed').classList.contains('on'))renderFeed();
  if($('tab-m2m').classList.contains('on'))renderM2M();
